# Backend example env for enabling real payments with Paychangu
# Copy this to .env in the backend folder and fill values before deploying

# Basic app
PORT=4000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Database (optional)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Payments
# Set to 'true' to enable payments flows; set to 'false' to make the site free
PAYMENTS_ENABLED=true

# Paychangu (Changu) credentials - obtain these from your Paychangu/Changu dashboard
PAYCHANGU_SECRET=SEC-YOUR_PAYCHANGU_SECRET_HERE
PAYCHANGU_API_BASE=https://api.paychangu.com
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret_here

# Flutterwave (optional fallback) keys
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxx
# FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret
# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://chimwazagift7:<gift000002!>@gift.mmcrg9v.mongodb.net/

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Cloudinary (for image storage)
CLOUDINARY_CLOUD_NAME=dtqfs6jd2
CLOUDINARY_API_KEY=587857937544199
CLOUDINARY_API_SECRET=**********

# Email (optional, for verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL
FRONTEND_URL=https://ominous-potato-974jgw5wgg96h7xgj-3000.app.github.dev

# Paychangu (payment gateway)
PAYCHANGU_API_KEY=pub-test-ibKiAbI9WjiGw4ptthEJeo09OnWLtotO
PAYCHANGU_SECRET=sec-test-N9aiSx8AfP9I7hUyPMyhIwZxAb5lIVB5
PAYCHANGU_WEBHOOK_SECRET=your_paychangu_webhook_secret_here
PAYCHANGU_ENV=test

# Flutterwave (aggregator supporting cards and mobile money)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_API_BASE=https://api.flutterwave.com
